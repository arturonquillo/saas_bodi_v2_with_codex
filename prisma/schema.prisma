generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ativa
  inadimplente
  cancelada
}

enum CanalAviso {
  email
  whatsapp
  ambos
}

enum SaasRole {
  supervisor
  vendedor
  estoquista
  entregador
}

enum DocumentType {
  cpf
  cnpj
}

enum OrderStatus {
  novo
  confirmado
  separando
  despachado
  entregue
  cancelado
}

enum OrderChannel {
  loja
  saas
}

enum PriceList {
  varejo
  atacado
}

enum MovementType {
  reserve
  release
  consume
  adjust
  import_apply
}

enum OutboxChannel {
  email
  whatsapp
}

enum OutboxRecipientRole {
  customer
  seller
}

enum OutboxStatus {
  pendente
  enviado
  falha
}

enum ImportBatchStatus {
  preview
  applied
  discarded
}

enum ImportRowAction {
  create
  update
  error
}

enum Surface {
  loja
  saas
  conta
}

model Tenant {
  id                   String             @id
  slug                 String             @unique
  nome                 String
  aceitaCpf            Boolean            @default(true) @map("aceita_cpf")
  aceitaCnpj           Boolean            @default(true) @map("aceita_cnpj")
  canaisAviso          CanalAviso         @default(ambos) @map("canais_aviso")
  defaultSellerUserId  String?            @map("default_seller_user_id")
  subscriptionStatus   SubscriptionStatus @default(ativa) @map("subscription_status")
  planDisplayName      String             @map("plan_display_name")
  createdAt            DateTime           @default(now()) @map("created_at")

  theme       Theme?
  memberships Membership[]
  customers   CustomerProfile[]
  skus        Sku[]
  balances    InventoryBalance[]
  movements   InventoryMovement[]
  orders      Order[]
  outbox      NotificationOutbox[]
  imports     InventoryImportBatch[]
  sessions    Session[]

  @@map("tenants")
}

model Theme {
  tenantId   String  @id @map("tenant_id")
  marca      String
  primary    String
  accent     String
  background String
  logoUrl    String? @map("logo_url")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("themes")
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String   @map("password_hash")
  nome         String
  whatsapp     String?
  createdAt    DateTime @default(now()) @map("created_at")

  memberships     Membership[]
  customerOf      CustomerProfile[]
  sessions        Session[]
  ordersAsCustomer Order[]           @relation("OrderCustomer")
  ordersAsSeller   Order[]           @relation("OrderSeller")
  movements        InventoryMovement[]
  importBatches    InventoryImportBatch[]
  statusChanges    OrderStatusHistory[]

  @@map("users")
}

model Membership {
  id            String    @id
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  saasRole      SaasRole? @map("saas_role")
  accountOwner  Boolean   @default(false) @map("account_owner")
  isCustomer    Boolean   @default(false) @map("is_customer")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, saasRole])
  @@map("memberships")
}

model CustomerProfile {
  id                    String       @id
  tenantId              String       @map("tenant_id")
  userId                String       @map("user_id")
  documentType          DocumentType @map("document_type")
  documentDigits        String       @map("document_digits")
  documentLast4         String       @map("document_last4")
  cnpjRegistroPendente  Boolean      @default(false) @map("cnpj_registro_pendente")
  razaoSocial           String?      @map("razao_social")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentDigits])
  @@unique([tenantId, userId])
  @@map("customer_profiles")
}

model Sku {
  id                   String  @id
  tenantId             String  @map("tenant_id")
  codigo               String
  nome                 String
  precoVarejoCentavos  Int     @map("preco_varejo_centavos")
  precoAtacadoCentavos Int     @map("preco_atacado_centavos")
  qtdMinAtacado        Int     @default(1) @map("qtd_min_atacado")
  visivelLoja          Boolean @default(true) @map("visivel_loja")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balance   InventoryBalance?
  movements InventoryMovement[]
  lines     OrderLine[]

  @@unique([tenantId, codigo])
  @@index([tenantId, visivelLoja])
  @@map("skus")
}

/// The only inventory ledger. Store stock is a projection of this row + visivel_loja.
model InventoryBalance {
  skuId    String @id @map("sku_id")
  tenantId String @map("tenant_id")
  onHand   Int    @default(0) @map("on_hand")
  reserved Int    @default(0)

  sku    Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id             String       @id
  tenantId       String       @map("tenant_id")
  skuId          String       @map("sku_id")
  orderId        String?      @map("order_id")
  importBatchId  String?      @map("import_batch_id")
  type           MovementType
  deltaOnHand    Int          @map("delta_on_hand")
  deltaReserved  Int          @map("delta_reserved")
  reason         String?
  actorUserId    String?      @map("actor_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku    Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  batch  InventoryImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([tenantId, skuId, createdAt])
  @@map("inventory_movements")
}

model Order {
  id              String       @id
  tenantId        String       @map("tenant_id")
  customerUserId  String       @map("customer_user_id")
  sellerUserId    String       @map("seller_user_id")
  channel         OrderChannel
  priceList       PriceList    @map("price_list")
  status          OrderStatus
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  User                 @relation("OrderCustomer", fields: [customerUserId], references: [id])
  seller    User                 @relation("OrderSeller", fields: [sellerUserId], references: [id])
  lines     OrderLine[]
  history   OrderStatusHistory[]
  outbox    NotificationOutbox[]
  movements InventoryMovement[]

  @@index([tenantId, status])
  @@index([tenantId, customerUserId])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderLine {
  id                 String    @id
  tenantId           String    @map("tenant_id")
  orderId            String    @map("order_id")
  skuId              String    @map("sku_id")
  codigoSnapshot     String    @map("codigo_snapshot")
  nomeSnapshot       String    @map("nome_snapshot")
  qty                Int
  unitPriceCentavos  Int       @map("unit_price_centavos")
  priceList          PriceList @map("price_list")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id])

  @@index([tenantId, orderId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id          String      @id
  tenantId    String      @map("tenant_id")
  orderId     String      @map("order_id")
  fromStatus  String?     @map("from_status")
  toStatus    OrderStatus @map("to_status")
  actorUserId String?     @map("actor_user_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, orderId, createdAt])
  @@map("order_status_histories")
}

model NotificationOutbox {
  id            String              @id
  tenantId      String              @map("tenant_id")
  orderId       String              @map("order_id")
  channel       OutboxChannel
  recipientRole OutboxRecipientRole @map("recipient_role")
  recipient     String
  templateKey   String              @map("template_key")
  payloadJson   String              @map("payload_json")
  status        OutboxStatus        @default(pendente)
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, orderId])
  @@map("notification_outbox")
}

model InventoryImportBatch {
  id              String             @id
  tenantId        String             @map("tenant_id")
  createdById     String             @map("created_by_id")
  instructionText String?            @map("instruction_text")
  status          ImportBatchStatus  @default(preview)
  fileName        String             @map("file_name")
  createdAt       DateTime           @default(now()) @map("created_at")
  appliedAt       DateTime?          @map("applied_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User                   @relation(fields: [createdById], references: [id])
  rows      InventoryImportRow[]
  movements InventoryMovement[]

  @@index([tenantId, createdAt])
  @@map("inventory_import_batches")
}

model InventoryImportRow {
  id        String          @id
  batchId   String          @map("batch_id")
  tenantId  String          @map("tenant_id")
  rowIndex  Int             @map("row_index")
  action    ImportRowAction
  payloadJson String        @map("payload_json")
  errorMessage String?      @map("error_message")
  applied   Boolean         @default(false)

  batch InventoryImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@map("inventory_import_rows")
}

model Session {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  surface   Surface
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("sessions")
}
