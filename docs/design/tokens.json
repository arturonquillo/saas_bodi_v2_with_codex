{
  "version": 1,
  "meta": {
    "locale": "pt-BR",
    "notes": "Store and SaaS consume tenant tokens. Account consumes product tokens only. Tenant-editable fields are marca, primary, accent, background, logo. System tokens (including Inter/IBM Plex fonts, hairline shadows, motion) are not in the theme editor. Visual language: Frappe Desk + Woo Storefront — docs/design/visual.md."
  },
  "surfaces": {
    "store": { "theme": "tenant", "density": "comfortable" },
    "saas": { "theme": "tenant", "density": "compact" },
    "account": { "theme": "product", "density": "comfortable" }
  },
  "tenantEditable": ["marca", "primary", "accent", "background", "logo"],
  "seed": {
    "tenantSlug": "demo",
    "marca": "Norte Atacado",
    "logo": {
      "kind": "wordmark",
      "src": null,
      "alt": "Norte Atacado"
    },
    "color": {
      "marca": "#0F4F3E",
      "primary": "#0F4F3E",
      "accent": "#C2410C",
      "background": "#F6EFE3",
      "text": "#1C1917",
      "textMuted": "#57534E",
      "textOnPrimary": "#F6EFE3",
      "textOnAccent": "#FFF7ED",
      "surface": "#FFFBF5",
      "surfaceRaised": "#FFFFFF",
      "border": "#E7DCCB",
      "danger": "#B42318",
      "success": "#1B7A4A",
      "warning": "#B45309"
    }
  },
  "product": {
    "marca": "saas_frota",
    "color": {
      "marca": "#1E3A5F",
      "primary": "#1E3A5F",
      "accent": "#3D6B8C",
      "background": "#F4F6F8",
      "text": "#142033",
      "textMuted": "#5B6573",
      "textOnPrimary": "#F4F6F8",
      "textOnAccent": "#F4F6F8",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "border": "#D5DCE3",
      "danger": "#B42318",
      "success": "#1B7A4A",
      "warning": "#B45309"
    }
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px"
  },
  "hitTarget": {
    "default": "36px",
    "mobileField": "44px",
    "warehouseCourier": "48px",
    "warehouseCourierPrimary": "52px"
  },
  "elevation": {
    "none": "none",
    "sm": "0 1px 2px rgba(0, 0, 0, 0.06)",
    "md": "0 2px 8px rgba(0, 0, 0, 0.08)",
    "card": "0 1px 2px rgba(0, 0, 0, 0.04)",
    "cardHover": "0 2px 8px rgba(0, 0, 0, 0.08)",
    "float": "0 8px 24px rgba(0, 0, 0, 0.12)"
  },
  "motion": {
    "durationFast": "160ms",
    "duration": "180ms",
    "easeStandard": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "typography": {
    "fontDisplay": "Inter, ui-sans-serif, system-ui, sans-serif",
    "fontBody": "Inter, ui-sans-serif, system-ui, sans-serif",
    "fontUi": "Inter, ui-sans-serif, system-ui, sans-serif",
    "fontFamily": "var(--font-ui)",
    "fontUiProduct": "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif",
    "googleFonts": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap",
    "store": { "body": "16px", "small": "14px", "kicker": "12px", "title": "24px", "display": "32px", "price": "20px", "priceLg": "28px" },
    "saas": { "body": "14px", "small": "12px", "kicker": "11px", "title": "20px", "display": "24px", "price": "16px", "priceLg": "22px" },
    "account": { "body": "16px", "small": "14px", "kicker": "12px", "title": "22px", "display": "28px", "price": "20px", "priceLg": "28px" },
    "lineHeight": { "tight": 1.15, "title": 1.25, "body": 1.45, "ui": 1.35 },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "trackingKicker": "0.08em"
  },
  "focus": {
    "ringWidth": "2px",
    "ringOffset": "2px"
  },
  "contrast": {
    "minBody": 4.5,
    "minLarge": 3.0,
    "backgroundAssumesLight": true
  }
}
